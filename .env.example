# ==========================================
# RAFEEQ ECOSYSTEM ENVIRONMENT CONFIGURATION
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI shopping assistant and content generation
GEMINI_API_KEY=your_gemini_api_key_here

# RENDER & POSTGRESQL DATABASE CONFIGURATION
PORT=10000
FLASK_ENV=production
JWT_SECRET_KEY=change_this_to_a_secure_random_string_32chars

# Render PostgreSQL Internal/External Database URL format:
# postgresql://rafeeq_user:password@dtr1-db.render.com/rafeeq_db
DATABASE_URL=postgresql://rafeeq_user:secure_password_here@dtr1-db.render.com/rafeeq_db

# SERVICE IDENTIFICATION
RENDER_SERVICE_NAME=dtr1-n-1
RENDER_SERVICE_ID=srv-d9if22faqgkc73a0g8fg
